# Corpus2Node — copy to .env and fill in.
#
# LLM chat credentials are managed at RUNTIME via the API (/settings/llm) and
# persisted to artifacts/llm_settings.json. You can stash multiple keys
# (OpenAI-compatible AND Anthropic) and bind each purpose — graph / critic /
# chat / exam — to one. The vars below are only a FIRST-RUN convenience seed,
# used to create credentials when the registry is still empty.

# --- First-run seed: OpenAI-compatible (DeepSeek, Kimi, vLLM, OpenRouter, ...) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# --- First-run seed: Anthropic-compatible ---
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

# --- API safety ---
APP_ENV=development
DEBUG_TRACEBACKS=true
CORS_ALLOW_ORIGINS=*
API_AUTH_TOKEN=
MAX_UPLOAD_BYTES=524288000

# --- Kimi (PDF extraction via Files API; not a chat model) ---
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.6

# --- Embeddings (bge_m3 local | openai_compatible) ---
EMBED_PROVIDER=bge_m3
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# --- Vector store (local_cosine | chroma) ---
VECTOR_STORE_PROVIDER=local_cosine

# --- Observability ---
LANGCHAIN_TRACING=false
LANGSMITH_API_KEY=
