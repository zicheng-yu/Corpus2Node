# Corpus2Node — copy to .env and fill in what you need.
#
# ⚠️  MODEL CREDENTIALS ARE CONFIGURED IN THE UI, NOT HERE.
# Open the app → 设置 → 模型: add credentials (OpenAI-compatible / Anthropic) and bind
# each purpose — graph / chat / critic / exam (chat), vision (Kimi: image·PDF·video),
# embedding (only when EMBED_PROVIDER=openai_compatible). They persist to
# artifacts/llm_settings.json. The keys in the "first-run seed" block below are ONLY a
# convenience to auto-create credentials when the registry is still empty, and they take
# effect only if EXPORTED into the environment (a value in this file alone is ignored by
# the app — it's read by the UI registry, not by Settings).

# ─────────────────── First-run seed (optional; export to use) ───────────────────
# Chat models — OpenAI-compatible (DeepSeek, vLLM, OpenRouter, …)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
# Chat models — Anthropic-compatible
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
# Multimodal vision — Kimi (image / PDF / video); seeds + binds the `vision` purpose
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6
# Remote embeddings — seeds + binds `embedding` (only when EMBED_PROVIDER=openai_compatible)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# ───────────────────────── Infrastructure (non-model) ──────────────────────────
# API safety
APP_ENV=development            # development | production
DEBUG_TRACEBACKS=true          # set false in production
CORS_ALLOW_ORIGINS=*           # comma-separated origins; "*" is dev only
API_AUTH_TOKEN=                # optional Bearer token for non-public routes
REQUIRE_AUTH_IN_PRODUCTION=true
ALLOW_EPHEMERAL_STORAGE=false  # only true for explicitly disposable previews
MAX_UPLOAD_BYTES=524288000     # 500 MB
MAX_DOCUMENT_UPLOAD_BYTES=52428800
MAX_PDF_UPLOAD_BYTES=209715200
MAX_IMAGE_UPLOAD_BYTES=20971520
MAX_ARCHIVE_UNCOMPRESSED_BYTES=209715200
UPLOAD_CHUNK_SIZE=1048576

# Embeddings engine (credentials for openai_compatible live in the UI registry)
EMBED_PROVIDER=bge_m3          # bge_m3 (local, needs --extra ml) | openai_compatible | hashing
EMBEDDING_DIMENSIONS=1024

# Vector store
VECTOR_STORE_PROVIDER=local_cosine   # local_cosine | chroma

# Multimodal (Kimi) request timeout, seconds
VISION_TIMEOUT_SECONDS=120

# Scientific PDF structure parser (self-hosted GROBID REST service)
GROBID_BASE_URL=http://localhost:8070

# Audio transcription — local faster-whisper (the Kimi API has no audio input)
WHISPER_MODEL_SIZE=base        # tiny | base | small | medium | large-v3
WHISPER_LANGUAGE=auto

# Observability / export
LANGCHAIN_TRACING=false
LANGSMITH_API_KEY=
WKHTMLTOPDF_PATH=
