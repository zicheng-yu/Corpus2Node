# Corpus2Node frontend — build the Vite SPA, serve it (and reverse-proxy /api) with nginx.
# Build context is the repo root (see deploy/docker-compose.yml).

ARG DOCKER_REGISTRY=docker.io

# ── Stage 1: build the static bundle ──────────────────────────────────────────
FROM ${DOCKER_REGISTRY}/library/node:22-alpine AS build
WORKDIR /app/frontend

# Use a fast npm registry mirror (CN). Override with
# --build-arg NPM_REGISTRY=https://registry.npmjs.org for non-CN builds.
ARG NPM_REGISTRY=https://registry.npmmirror.com
RUN npm config set registry "$NPM_REGISTRY"

# Install deps from the lockfile first (cache-friendly).
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# All API calls go to /api/* (same origin); nginx proxies that to the backend.
# Vite picks up VITE_-prefixed vars from the environment at build time.
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

COPY frontend/ ./
RUN npm run build

# ── Stage 2: nginx serving the built assets + proxying the API ────────────────
FROM ${DOCKER_REGISTRY}/library/nginx:alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/frontend/dist /usr/share/nginx/html
EXPOSE 80
