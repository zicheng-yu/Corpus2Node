# Corpus2Node backend — FastAPI + uvicorn, uv-managed, core deps only (no torch).
# Build context is the repo root (see deploy/docker-compose.yml).
ARG DOCKER_REGISTRY=docker.io
FROM ${DOCKER_REGISTRY}/library/python:3.12-slim

# Runtime libs for faster-whisper (ctranslate2 / onnxruntime link against libgomp).
ARG DEBIAN_MIRROR=deb.debian.org
RUN sed -i "s|deb.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# uv (fast resolver/installer). Tsinghua mirror keeps the pip bootstrap quick in CN.
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple uv

# Point uv at the Tsinghua PyPI mirror too (fast wheel downloads in CN). Override with
# --build-arg PIP_INDEX=https://pypi.org/simple for non-CN builds.
ARG PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
ARG PYPI_FILES_BASE=https://files.pythonhosted.org/packages
ENV UV_INDEX_URL=$PIP_INDEX
ENV UV_DEFAULT_INDEX=$PIP_INDEX

WORKDIR /app

# 1) Dependency layer first (cache-friendly): resolve the env without the project,
#    so source edits don't bust the (slow) dependency install layer.
#    README.md is referenced by pyproject `readme=`, so it must be present to build.
COPY pyproject.toml uv.lock README.md ./
# A frozen uv lock records wheel URLs from files.pythonhosted.org. Keep the
# default unchanged, but allow regional builds to rewrite only the artifact
# host while preserving the locked paths and hashes.
RUN sed -i "s|https://files.pythonhosted.org/packages|${PYPI_FILES_BASE}|g" uv.lock
RUN uv sync --frozen --no-dev --extra export --no-install-project

# 2) App source, then install the project itself into the same venv.
COPY src ./src
COPY web ./web
COPY alembic.ini ./alembic.ini
COPY alembic ./alembic
COPY deploy/start-backend.sh ./deploy/start-backend.sh
RUN uv sync --frozen --no-dev --extra export
RUN chmod +x ./deploy/start-backend.sh

EXPOSE 8000
CMD ["./deploy/start-backend.sh"]
